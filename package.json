{
  "name": "@saas-auto-catalogo/ai-content-worker",
  "version": "1.0.0",
  "description": "Worker autônomo de Pesquisa Profunda (Open Deep Research) e Redação com Gemini para o Blog Audience First do Auto Catálogo SaaS",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
